# BTObot — Environment Variables  (.env.example)
# ================================================
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.3

# --- Storage paths ---
CHROMA_PATH=./chroma_db
PARENT_STORE_PATH=./parent_store

# --- Chunking (chars, not tokens) ---
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=120
CHILD_CHUNK_SIZE=600
CHILD_CHUNK_OVERLAP=80

# --- Retrieval ---
TOP_K_CHILDREN=10   # children fetched from Chroma before parent expansion
TOP_N_FINAL=3       # parent docs shown to LLM (and cited to user)

# --- Scraping ---
SCRAPE_DELAY_SECONDS=1.5
