# BTObot — Environment Variables  (.env.example)
# ================================================
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=mxbai-embed-large
LLM_TEMPERATURE=0.3

# --- Storage paths ---
CHROMA_PATH=./chroma_db
PARENT_STORE_PATH=./parent_store

# --- Chunking (chars, not tokens) ---
PARENT_CHUNK_SIZE=1000
PARENT_CHUNK_OVERLAP=100
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K_CHILDREN=10   # children fetched from Chroma before parent expansion
TOP_N_FINAL=3       # parent docs shown to LLM (and cited to user)

# --- Reranker ---
# Options: ms-marco-TinyBERT-L-2-v2 (4 MB, fastest)
#          ms-marco-MiniLM-L-12-v2  (34 MB, recommended)
RERANK_MODEL=ms-marco-MiniLM-L-12-v2

# --- Scraping ---
SCRAPE_DELAY_SECONDS=1.5
